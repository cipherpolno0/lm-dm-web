# Environment variable template — see data-policy.md ข้อ 6 (Secret handling) and
# dev-rules.md ข้อ 7. Copy this file to `.env.local` for local development and
# fill in real (non-committed) values. NEVER commit `.env` / `.env.local` /
# `.env.production` — they are already excluded via .gitignore.
#
# This is a template only: none of the values below are real secrets. Most of
# these variables are not wired into the application yet in this phase.
# DATABASE_URL is now used by prisma/dev-migrate-verify.mjs (see prisma/MIGRATIONS.md)
# — the rest are listed here ahead of time so the shape of configuration is
# visible from day one, per data-policy.md's requirement that `.env.example`
# always stays in sync with variables the project expects to use.

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="ระบบฐานข้อมูลคณะสงฆ์และการศึกษาพระปริยัติธรรม"
NEXT_PUBLIC_APP_ENV=development

# --- Database (Prisma / PostgreSQL) — wired starting P1 Data Model phase ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/sangha_system_dev"

# --- Auth.js — wired starting P3 Authentication & RBAC phase ----------------
# Generate a real secret locally with: npx auth secret (or `openssl rand -base64 32`)
# Never reuse the same value across dev/staging/prod (data-policy.md ข้อ 8)
AUTH_SECRET="replace-with-a-generated-secret-never-commit-the-real-value"
AUTH_URL="http://localhost:3000"

# Session/rate-limit tunables — all optional, sensible defaults in code
# (src/lib/auth-config.ts). ค่าเริ่มต้นเป็นการตัดสินใจเชิงวิศวกรรมที่บันทึกไว้ใน
# prisma/AUTH.md (dev-rules.md §10 เลื่อนการตัดสินใจ session timeout มาเฟสนี้
# โดยตั้งใจ) — ในอนาคต F6.5 จะย้ายค่าพวกนี้ไปเป็น Super-Admin-configurable setting
# แทนที่จะเป็น env var แบบตายตัว
# AUTH_SESSION_MAX_AGE_SECONDS=28800      # 8 ชั่วโมง
# AUTH_LOGIN_LOCKOUT_THRESHOLD=5          # requirements.md §8 AC2
# AUTH_LOGIN_LOCKOUT_MINUTES=15

# --- Object Storage (PDF / attachments) — wired starting M8 module ----------
# Provider not yet selected (see project-charter.md ข้อ 8, dependency: pending)
OBJECT_STORAGE_ENDPOINT="https://storage.example-provider.invalid"
OBJECT_STORAGE_BUCKET="sangha-system-dev"
OBJECT_STORAGE_ACCESS_KEY_ID="replace-with-real-access-key-never-commit"
OBJECT_STORAGE_SECRET_ACCESS_KEY="replace-with-real-secret-key-never-commit"
